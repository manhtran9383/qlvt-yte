+            ("GRID", (0, 0), (-1, -1), 0.5, colors.grey),
+            ("ALIGN", (0, 0), (-1, -1), "CENTER"),
+        ]))
+        doc.build([Paragraph(title, st["title"]), Spacer(1, 4 * mm), tbl])
+        return path, None
+    except Exception as e:
+        return None, f"{type(e).__name__}: {e}"
+    finally:
+        if doi_lang:
+            set_lang(lang_cu)
