+    assert n1 == n0, "ngày sai định dạng vẫn được ghi phiếu"
+    assert "YYYY-MM-DD" in app.v_gia.cget("text")
+    assert len(app.cart) == 1, "giỏ bị xóa dù chưa ghi được phiếu"
+    app._clear_cart()
